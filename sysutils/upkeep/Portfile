# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                upkeep
version             0.11.0
revision            0
categories          sysutils
platforms           darwin
supported_archs     arm64 x86_64
license             MIT
maintainers         @teknikqa
installs_libs       no

description         Keep your macOS development environment up to date

long_description    upkeep is a shell-independent CLI that scans and \
                     updates Homebrew, npm/pnpm/yarn/bun, Composer, pip, \
                     Rust, uv, code editor extensions, Oh My Zsh, Vim, \
                     Vagrant, MacPorts, and Mac App Store apps in a single \
                     scan/confirm/execute pass.

homepage            https://github.com/teknikqa/upkeep

master_sites        https://github.com/teknikqa/upkeep/releases/download/v${version}/

# upkeep ships prebuilt darwin_arm64/darwin_amd64 tarballs (no source build
# needed); pick the right one for the arch this port is being built for.
platform arm {
    set upkeep_arch     arm64
}
platform i386 {
    set upkeep_arch     amd64
}

if {${os.arch} ni [list arm i386]} {
    known_fail      yes
    pre-fetch {
        ui_error "upkeep is only available for arm64 or x86_64 macOS."
        error {unsupported platform}
    }
}

set upkeep_distfile upkeep_${version}_darwin_${upkeep_arch}.tar.gz
distfiles           ${upkeep_distfile}

# Set build_arch by hand to fetch/checksum the other arch:
#   sudo port -d checksum upkeep os.arch=i386 build_arch=x86_64
#   sudo port -d checksum upkeep os.arch=arm build_arch=arm64
if {${build_arch} eq {arm64}} {
    checksums       ${upkeep_distfile} \
                    rmd160  aff0af9c4f66ef4c71e7bc738d5c1d929e2e90b0 \
                    sha256  dc0f7305ce94acb283ba8d822c5a78405c0989adb2111bc8b79ae8a7d62df0ad \
                    size    3170697
} elseif {${build_arch} eq {x86_64}} {
    checksums       ${upkeep_distfile} \
                    rmd160  8960223a591f1ca473f8832620f3a5764076a4f8 \
                    sha256  090d957a70516445103746bc3ff8ce687a4d4f642f41eedebfe780d5b30a5f88 \
                    size    3410874
}

# The tarball has no wrapping directory, so extracted files land directly
# in workpath rather than a ${distname}-named subdirectory.
worksrcdir          ""

use_configure       no
build {}

destroot {
    xinstall -m 0755 ${worksrcpath}/upkeep ${destroot}${prefix}/bin/upkeep
}
